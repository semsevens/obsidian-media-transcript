{
  "name": "obsidian-media-transcript",
  "version": "2.17.0",
  "description": "Obsidian plugin Media One: media player with synchronized transcripts, annotations, web image archive and hotlink-protected media",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && npm test && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "vitest run && npm run test:node",
    "test:watch": "vitest",
    "test:node": "node --experimental-strip-types --no-warnings --test 'tests/archive/**/*.test.mts' 'tests/hotlink/**/*.test.mts'"
  },
  "keywords": [],
  "author": "semsevens",
  "license": "MIT",
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "0.17.3",
    "happy-dom": "^15.11.7",
    "jsdom": "^30.1.3",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
